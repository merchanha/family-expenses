NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://tandem:tandem@localhost:5433/tandem?schema=public
CORS_ORIGIN=http://localhost:5173
# Replace in any shared/prod environment (min 32 chars).
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
# Optional/unused since P1: refresh tokens are opaque random values stored hashed.
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
# Public web origin, used to build reset/invite links.
WEB_APP_URL=http://localhost:5173
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie `tandem_rt` (Path=/api/auth, HttpOnly). Local: lax + insecure (Vite proxy is same-origin).
# Production (Cloudflare Pages -> Cloud Run is cross-site): REFRESH_COOKIE_SAMESITE=none, REFRESH_COOKIE_SECURE=true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_DAYS=7
# Rate limit on credential endpoints (per IP, per instance).
AUTH_THROTTLE_LIMIT=10
AUTH_REFRESH_THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_SECONDS=60
