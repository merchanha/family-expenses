{
  "name": "tandem-expenses",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @tandem/api start:dev",
    "dev:web": "pnpm --filter @tandem/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  }
}
